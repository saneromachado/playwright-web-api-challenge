{
  "name": "playwright-web-api-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "Desafio tecnico de automacao Web e API com Playwright e TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:web": "playwright test --project=web",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --project=web --headed",
    "test:debug": "playwright test --project=web --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "typescript": "5.9.2"
  }
}
